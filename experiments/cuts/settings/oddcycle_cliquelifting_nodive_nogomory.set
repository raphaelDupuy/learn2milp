# oddcycle_cliquelifting.set without distribution diving and without Gomory
# cuts (see oddcycle_cliquelifting_nodive.set and _nogomory.set).

# Zero-half cuts as by default, and the odd-cycle separator (SCIP: off) at the
# root and at depths 10 and 40.
# Every separator that SCIP calls at the nodes by default, except zero-half,
# is restricted to the root node.
separating/aggregation/freq = 0
separating/cmir/freq = 0
separating/flowcover/freq = 0
separating/gomory/freq = -1
separating/gomorymi/freq = 0
separating/impliedbounds/freq = 0
separating/knapsackcover/freq = 0
separating/minor/freq = 0
separating/mixing/freq = 0
separating/strongcg/freq = 0
separating/oddcycle/freq = 10

# Clique lifting in presolve (see cliquelifting.set).
constraints/setppc/cliquelifting = TRUE

heuristics/distributiondiving/freq = -1
